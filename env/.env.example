# Required
DATABASE_URL=postgres://arcade:arcade@localhost:5432/arcade
GAME_SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
ARCADE_ADMIN_EMAILS=admin@example.com
# Emergency-only production bootstrap. Prefer ARCADE_ADMIN_EMAILS.
# ARCADE_ALLOW_FIRST_ADMIN_BOOTSTRAP=false

# Optional development hostnames for Next HMR (comma-separated, no schemes).
# ARCADE_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Recommended public origin. The app falls back to localhost when omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional URL fallbacks/overrides
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
# VERCEL_URL=

# Optional trusted-proxy auth. Keep omitted or false unless a trusted proxy
# injects authenticated user headers.
# ARCADE_TRUST_PROXY_AUTH=false

# 8-ball practice against the bot for signed-out players (no tickets, rating
# or history). Unset: on in development, off in production.
# POOL_GUEST_PRACTICE=false

# Auth rate limiting. TRUSTED_PROXY_COUNT is how many reverse-proxy hops sit in
# front of the app; the client IP is read that many entries from the right of
# X-Forwarded-For (default 1). Set to 0 to ignore X-Forwarded-For entirely.
# Setting this correctly is what keeps signin rate limiting effective, since a
# client cannot forge the appended hop.
# TRUSTED_PROXY_COUNT=1
# SIGNIN_RATE_LIMIT=10          # attempts / 15 min / identifier+IP
# SIGNIN_ID_RATE_LIMIT=20       # attempts / 15 min / identifier across all IPs
# SIGNIN_IP_RATE_LIMIT=60       # attempts / 15 min / IP across all identifiers
# REGISTER_RATE_LIMIT=60        # attempts / hour / IP
# RECOVER_RATE_LIMIT=5          # attempts / hour / identifier and / IP
# RATE_LIMIT_IP_ALLOWLIST=      # comma-separated IPs that bypass auth limits
# MAX_HTTP_BODY_BYTES=1048576   # global Content-Length ceiling (default 1 MiB)

# Optional anti-cheat logging controls
# ANTI_CHEAT_LOG_PASSES=false
# ANTI_CHEAT_LOG_RETENTION_DAYS=14

# Optional stable key for one-way product-retention pseudonyms. When omitted,
# GAME_SESSION_SECRET is used. Changing either active key resets D1/D7 cohorts.
# PRODUCT_ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Optional browser-exposed AdSense client ID
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9188105841935377
# ADSENSE_PUBLISHER_ID=pub-9188105841935377
# NEXT_PUBLIC_ADSENSE_ENABLE_GAME_ADS=false
# NEXT_PUBLIC_ADSENSE_GAME_TOP_SLOT=
# NEXT_PUBLIC_ADSENSE_GAME_BOTTOM_SLOT=
# NEXT_PUBLIC_ADSENSE_DISABLED_GAME_ROUTES=

# Optional Google Ad Manager rewarded ads
# NEXT_PUBLIC_GAM_REWARDED_AD_UNIT_PATH=
# AD_REWARD_STORE_TICKETS=25
# AD_REWARD_DAILY_LIMIT=10
# AD_REWARD_COOLDOWN_MS=60000
# AD_REWARD_INTENT_TTL_MS=600000

# Optional Stripe ticket purchases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TICKET_PACKS_JSON=
